# پراکسی (اختیاری) — اگر اتصال مستقیم به تلگرام ناپایدار یا فیلتر است، اینجا تنظیم کنید.
# مثال HTTP:   PROXY_URL=http://127.0.0.1:10809
# مثال SOCKS5: PROXY_URL=socks5://127.0.0.1:1080   (نیاز به: pip install "httpx[socks]")
